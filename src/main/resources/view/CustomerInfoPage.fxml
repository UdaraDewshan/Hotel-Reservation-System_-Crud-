<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="620.0" prefWidth="620.0" style="-fx-background-color: linear-gradient(to bottom right, #cce3f0, #412bfb);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.CustomerInfo_Controller">

    <children>

        <!-- Title -->
        <Text fill="#1a3c5a" layoutX="180.0" layoutY="55.0" text="Customer Information">
            <font>
                <Font name="Segoe UI Semibold" size="24.0" />
            </font>
            <effect>
                <DropShadow color="#b0b0b0" radius="5.0" />
            </effect>
        </Text>

        <!-- Main container -->
        <Pane layoutX="35.0" layoutY="79.0" prefHeight="482.0" prefWidth="550.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 3);">

            <children>

                <!-- Table -->
                <TableView fx:id="tblCustomer" layoutX="14.0" layoutY="14.0" prefHeight="260.0" prefWidth="522.0" style="-fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colCustomerId" prefWidth="95.20001983642578" text="Customer ID" />
                        <TableColumn fx:id="colName" prefWidth="115.199951171875" text="Name" />
                        <TableColumn fx:id="colPhone" prefWidth="122.39996337890625" text="Phone No" />
                        <TableColumn fx:id="colCity" prefWidth="102.39996337890625" text="City" />
                        <TableColumn fx:id="colAge" prefWidth="87.99996948242188" text="Age" />
                    </columns>
                </TableView>

                <!-- Input Fields -->
                <TextField fx:id="txtCustomerId" layoutX="30.0" layoutY="300.0" prefHeight="27.0" prefWidth="115.0" promptText="Customer ID" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtName" layoutX="171.0" layoutY="300.0" prefHeight="27.0" prefWidth="170.0" promptText="Name" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtPhone" layoutX="355.0" layoutY="300.0" prefHeight="27.0" prefWidth="170.0" promptText="Phone" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtCity" layoutX="30.0" layoutY="350.0" prefHeight="27.0" prefWidth="170.0" promptText="City" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtAge" layoutX="222.0" layoutY="350.0" prefWidth="80.0" promptText="Age" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />

                <!-- Buttons -->
                <Button fx:id="btnAdd" layoutX="60.0" layoutY="427.0" onAction="#btnAddAction" prefWidth="90.0" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px;" text="Add" />
                <Button fx:id="btnUpdate" layoutX="171.0" layoutY="427.0" onAction="#btnUpdateAction" prefWidth="90.0" style="-fx-background-color: #2196f3; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px;" text="Update" />
                <Button fx:id="btnDelete" layoutX="283.0" layoutY="427.0" onAction="#btnDeleteAction" prefWidth="90.0" style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px;" text="Delete" />
                <Button fx:id="btnClear" layoutX="395.0" layoutY="427.0" onAction="#btnClearAction" prefWidth="90.0" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px;" text="Clear" />
            </children>
        </Pane>
      <Button fx:id="btnBack" layoutX="451.0" layoutY="32.0" onAction="#btnBackAction" prefWidth="90.0" style="-fx-background-color: #070800; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px;" text="Back" textFill="WHITE">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Button>
    </children>
</AnchorPane>
