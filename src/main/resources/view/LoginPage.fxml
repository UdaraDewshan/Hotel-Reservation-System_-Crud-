<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="468.0" prefWidth="619.0" style="-fx-background-color: linear-gradient(to bottom right, #4facfe, #00f2fe);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.LoginPage_Controller">

    <children>
        <!-- Center Card -->
        <Pane layoutX="84.0" layoutY="78.0" prefHeight="340.0" prefWidth="450.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);">

            <children>
                <Text layoutX="180.0" layoutY="60.0" style="-fx-fill: #333333;" text="Welcome Back!">
                    <font>
                        <Font name="Segoe UI Bold" size="24.0" />
                    </font>
                </Text>

                <Text layoutX="95.0" layoutY="120.0" style="-fx-fill: #666666;" text="Username or Email">
                    <font>
                        <Font name="Segoe UI" size="14.0" />
                    </font>
                </Text>

                <TextField fx:id="txtUsername" layoutX="90.0" layoutY="130.0" prefHeight="35.0" prefWidth="270.0" promptText="Enter your username or email" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #b0bec5; -fx-border-width: 1; -fx-padding: 0 10 0 10;" />

                <Text layoutX="95.0" layoutY="200.0" style="-fx-fill: #666666;" text="Password">
                    <font>
                        <Font name="Segoe UI" size="14.0" />
                    </font>
                </Text>

                <PasswordField fx:id="txtPassword" layoutX="90.0" layoutY="210.0" prefHeight="35.0" prefWidth="270.0" promptText="Enter your password" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #b0bec5; -fx-border-width: 1; -fx-padding: 0 10 0 10;" />

                <Button fx:id="btnLogin" layoutX="150.0" layoutY="270.0" onAction="#btnLoginAction" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe);                                -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;                                -fx-background-radius: 20; -fx-cursor: hand;" text="Login">
                    <effect>
                        <DropShadow color="#81d4fa" radius="10" />
                    </effect>
                </Button>
            </children>
        </Pane>

        <!-- Optional top text -->
        <Text layoutX="164.0" layoutY="56.0" style="-fx-fill: white;" text="Hotel Resavation System">
            <font>
                <Font name="Segoe UI Bold" size="26.0" />
            </font>
        </Text>

    </children>
</AnchorPane>
