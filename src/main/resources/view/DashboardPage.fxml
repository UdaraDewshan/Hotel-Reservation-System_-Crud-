<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: linear-gradient(to bottom right, #e0f7fa, #80deea);" stylesheets="@../css/Style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.DashboardPage_Controller">

    <children>
        <Button fx:id="btnRoomInfomation" layoutX="48.0" layoutY="44.0" mnemonicParsing="false" onAction="#roomInfoAction" prefHeight="78.0" prefWidth="226.0" styleClass="dashboard-btn" text="Room Information">
            <font>
                <Font size="18.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <Button fx:id="btnCustomerInfo" layoutX="324.0" layoutY="161.0" mnemonicParsing="false" onAction="#customerInfoAction" prefHeight="78.0" prefWidth="225.0" styleClass="dashboard-btn" text="Customer Information">
            <font>
                <Font size="18.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
        <Button fx:id="btnStaff" layoutX="48.0" layoutY="268.0" mnemonicParsing="false" onAction="#staffAction" prefHeight="78.0" prefWidth="225.0" styleClass="dashboard-btn" text="Staff">
            <font>
                <Font size="18.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
    </children>
</AnchorPane>
