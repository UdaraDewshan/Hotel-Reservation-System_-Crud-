<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="566.0" prefWidth="720.0" style="-fx-background-color: linear-gradient(to bottom right, #cce3f0, #eaf9f0);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.StaffPage_Controller">

    <children>

        <!-- Title -->
        <Text fill="#1a3c5a" layoutX="266.0" layoutY="48.0" text="Staff Information">
            <font>
                <Font name="Segoe UI Semibold" size="24.0" />
            </font>
            <effect>
                <DropShadow color="#b0b0b0" radius="5.0" />
            </effect>
        </Text>

        <!-- Main container -->
        <Pane layoutX="31.0" layoutY="81.0" prefHeight="454.0" prefWidth="657.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 3);">

            <children>

                <!-- Table -->
                <TableView fx:id="tblStaff" layoutX="13.0" layoutY="20.0" prefHeight="253.0" prefWidth="638.0" style="-fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colStaff" prefWidth="80.0" text="Staff_id" />
                        <TableColumn fx:id="colName" prefWidth="120.0" text="Name" />
                        <TableColumn fx:id="colRole" prefWidth="120.0" text="Role" />
                        <TableColumn fx:id="colEmail" prefWidth="100.0" text="Email" />
                        <TableColumn fx:id="colPhone" prefWidth="118.4000244140625" text="Phone No" />
                        <TableColumn fx:id="colSallry" prefWidth="99.20001220703125" text="Sallary" />
                    </columns>
                </TableView>

                <!-- Input Fields -->
                <TextField fx:id="txtStaffId" layoutX="30.0" layoutY="300.0" prefHeight="27.0" prefWidth="120.0" promptText="Customer ID" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtName" layoutX="160.0" layoutY="300.0" prefHeight="27.0" prefWidth="130.0" promptText="Name" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtRole" layoutX="300.0" layoutY="300.0" prefHeight="27.0" prefWidth="130.0" promptText="Role" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtEmail" layoutX="30.0" layoutY="350.0" prefWidth="150.0" promptText="Email" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtPhoneNo" layoutX="200.0" layoutY="350.0" prefHeight="27.0" prefWidth="110.0" promptText="Phone No" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />

                <!-- Buttons -->
                <Button fx:id="btnAdd" layoutX="30.0" layoutY="400.0" onAction="#btnAddAction" prefWidth="90.0" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px;" text="Add" />
                <Button fx:id="btnUpdate" layoutX="130.0" layoutY="400.0" onAction="#btnUpdateAction" prefWidth="90.0" style="-fx-background-color: #2196f3; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px;" text="Update" />
                <Button fx:id="btnDelete" layoutX="230.0" layoutY="400.0" onAction="#btnDeleteAction" prefWidth="90.0" style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px;" text="Delete" />
                <Button fx:id="btnClear" layoutX="330.0" layoutY="400.0" onAction="#btnClearAction" prefWidth="90.0" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px;" text="Clear" />
                <TextField fx:id="txtSalary" layoutX="332.0" layoutY="350.0" prefWidth="110.0" promptText="Sallary" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
            </children>
        </Pane>
      <Button fx:id="btnBack" layoutX="571.0" layoutY="26.0" onAction="#btnBackAction" prefWidth="90.0" style="-fx-background-color: #070800; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px;" text="Back" />
    </children>
</AnchorPane>
