<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="578.0" prefWidth="691.0" style="-fx-background-color: linear-gradient(to bottom right, #cce3f0, #412bfb);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.StraffController">

    <children>

        <!-- Title -->
        <Text fill="#1a3c5a" layoutX="269.0" layoutY="54.0" text="Staff Information">
            <font>
                <Font name="Segoe UI Semibold" size="24.0" />
            </font>
            <effect>
                <DropShadow color="#b0b0b0" radius="5.0" />
            </effect>
        </Text>

        <!-- Main container -->
        <Pane layoutX="34.0" layoutY="80.0" prefHeight="477.0" prefWidth="622.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 3);">

            <children>

                <!-- Table -->
                <TableView fx:id="tblRoomInfo" layoutX="14.0" layoutY="14.0" prefHeight="252.0" prefWidth="595.0" style="-fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colStaffId" prefWidth="71.20004272460938" text="Staff ID" />
                        <TableColumn fx:id="colName" prefWidth="106.40003204345703" text="Name" />
                        <TableColumn fx:id="colRole" prefWidth="108.79998779296875" text="Role" />
                        <TableColumn fx:id="colEmail" prefWidth="112.0" text="Email" />
                  <TableColumn fx:id="colPhone" prefWidth="92.79989624023438" text="Phone " />
                  <TableColumn fx:id="colSalary" prefWidth="99.9998779296875" text="Salary" />
                    </columns>
                </TableView>

                <!-- Input Fields -->
                <TextField fx:id="txtRoomId" layoutX="36.0" layoutY="307.0" prefHeight="27.0" prefWidth="177.0" promptText="Room ID" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtName" layoutX="237.0" layoutY="307.0" prefHeight="27.0" prefWidth="170.0" promptText="Name" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtPhone" layoutX="237.0" layoutY="350.0" prefHeight="27.0" prefWidth="170.0" promptText="Phone" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtEmail" layoutX="36.0" layoutY="350.0" prefHeight="27.0" prefWidth="177.0" promptText="Email" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />

                <!-- Buttons -->
                <Button fx:id="btnAdd" layoutX="104.0" layoutY="427.0" onAction="#btnAddAction" prefWidth="90.0" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15;" text="Add" />
                <Button fx:id="btnUpdate" layoutX="213.0" layoutY="427.0" onAction="#btnUpdateAction" prefWidth="90.0" style="-fx-background-color: #2196f3; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15;" text="Update" />
                <Button fx:id="btnDelete" layoutX="322.0" layoutY="427.0" onAction="#btnDeleteAction" prefWidth="90.0" style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15;" text="Delete" />
                <Button fx:id="btnClear" layoutX="434.0" layoutY="427.0" onAction="#btnClearAction" prefWidth="90.0" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15;" text="Clear" />
            <TextField fx:id="txtRole" layoutX="421.0" layoutY="307.0" prefHeight="27.0" prefWidth="177.0" promptText="Role" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
            <TextField fx:id="txtSalary" layoutX="425.0" layoutY="350.0" prefHeight="27.0" prefWidth="170.0" promptText="Salary" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
            </children>
        </Pane>
        <Button fx:id="btnBack" layoutX="536.0" layoutY="30.0" onAction="#btnBackAction" prefWidth="90.0" style="-fx-background-color: #070800; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px; -fx-border-style: bolt;" text="Back">
            <font>
                <Font name="Berlin Sans FB Bold" size="33.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
