<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="592.0" prefWidth="620.0" style="-fx-background-color: linear-gradient(to bottom right, #cce3f0, #412bfb);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.RoomInfo_Controller">

    <children>

        <!-- Title -->
        <Text fill="#1a3c5a" layoutX="204.0" layoutY="52.0" text="Rooms Information">
            <font>
                <Font name="Segoe UI Semibold" size="24.0" />
            </font>
            <effect>
                <DropShadow color="#b0b0b0" radius="5.0" />
            </effect>
        </Text>

        <!-- Main container -->
        <Pane layoutX="34.0" layoutY="80.0" prefHeight="482.0" prefWidth="550.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 3);">

            <children>

                <!-- Table -->
                <TableView fx:id="tblRoomInfo" layoutX="14.0" layoutY="14.0" prefHeight="260.0" prefWidth="522.0" style="-fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colRoomId" prefWidth="95.20001983642578" text="Room ID" />
                        <TableColumn fx:id="colType" prefWidth="148.00006103515625" text="Type" />
                        <TableColumn fx:id="colDescription" prefWidth="170.39990234375" text="Description" />
                        <TableColumn fx:id="colPrice" prefWidth="107.20004272460938" text="Price" />
                    </columns>
                </TableView>

                <!-- Input Fields -->
                <TextField fx:id="txtRoomId" layoutX="98.0" layoutY="307.0" prefHeight="27.0" prefWidth="177.0" promptText="Room ID" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtType" layoutX="293.0" layoutY="307.0" prefHeight="27.0" prefWidth="170.0" promptText="Type" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtDiscription" layoutX="293.0" layoutY="350.0" prefHeight="27.0" prefWidth="170.0" promptText="Description" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />
                <TextField fx:id="txtPrice" layoutX="98.0" layoutY="350.0" prefHeight="27.0" prefWidth="177.0" promptText="Price" style="-fx-background-radius: 10; -fx-background-color: #f5f9fc; -fx-border-color: #90caf9; -fx-border-radius: 10;" />

                <!-- Buttons -->
                <Button fx:id="btnAdd" layoutX="70.0" layoutY="427.0" onAction="#btnAddAction" prefWidth="90.0" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15;" text="Add" />
                <Button fx:id="btnUpdate" layoutX="177.0" layoutY="427.0" onAction="#btnUpdateAction" prefWidth="90.0" style="-fx-background-color: #2196f3; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15;" text="Update" />
                <Button fx:id="btnDelete" layoutX="288.0" layoutY="427.0" onAction="#btnDeleteAction" prefWidth="90.0" style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15;" text="Delete" />
                <Button fx:id="btnClear" layoutX="395.0" layoutY="427.0" onAction="#btnClearAction" prefWidth="90.0" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15;" text="Clear" />
            </children>
        </Pane>
      <Button fx:id="btnBack" layoutX="487.0" layoutY="30.0" onAction="#btnBackAction" prefWidth="90.0" style="-fx-background-color: #070800; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 15px; -fx-border-style: bolt;" text="Back">
         <font>
            <Font name="Berlin Sans FB Bold" size="33.0" />
         </font>
      </Button>
    </children>
</AnchorPane>
